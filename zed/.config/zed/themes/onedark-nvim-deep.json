{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "OneDark.nvim Deep",
  "author": "navarasu/onedark.nvim ported for Zed",
  "themes": [
    {
      "name": "OneDark.nvim Deep",
      "appearance": "dark",
      "style": {
        "background": "#1a212e",
        "foreground": "#93a4c3",
        "accent": "#41a7fc",

        "editor.background": "#1a212e",
        "editor.foreground": "#93a4c3",
        "editor.gutter.background": "#1a212e",
        "editor.line_number": "#455574",
        "editor.active_line_number": "#93a4c3",
        "editor.active_line.background": "#21283b",
        "editor.selection.background": "#6c7d9c",
        "editor.cursor": "#93a4c3",

        "panel.background": "#141b24",
        "panel.focused_border": "#41a7fc",
        "pane.focused_border": "#41a7fc",

        "tab_bar.background": "#141b24",
        "tab.active_background": "#1a212e",
        "tab.inactive_background": "#141b24",

        "status_bar.background": "#141b24",
        "status_bar.foreground": "#93a4c3",

        "terminal.background": "#1a212e",
        "terminal.foreground": "#93a4c3",

        "error": "#f65866",
        "warning": "#efbd5d",
        "success": "#8bcd5b",
        "info": "#41a7fc",

        "syntax": {
          "attribute": { "color": "#dd9046" },
          "boolean": { "color": "#dd9046" },
          "comment": {
            "color": "#455574",
            "font_style": "italic"
          },
          "constant": { "color": "#dd9046" },
          "constructor": { "color": "#efbd5d" },
          "function": { "color": "#41a7fc" },
          "keyword": { "color": "#c75ae8" },
          "number": { "color": "#dd9046" },
          "operator": { "color": "#34bfd0" },
          "property": { "color": "#f65866" },
          "punctuation": { "color": "#93a4c3" },
          "string": { "color": "#8bcd5b" },
          "string.escape": { "color": "#34bfd0" },
          "type": { "color": "#efbd5d" },
          "variable": { "color": "#93a4c3" },
          "variable.special": { "color": "#f65866" }
        },
"players": [
  {
    "cursor": "#41a7fcff",
    "background": "#41a7fcff",
    "selection": "#6c7d9c99"
  }
]
      }
    }
  ]
}
